# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# App URLs
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:5000

# React (CRA) — API base URL (leave empty to use same origin in production)
REACT_APP_API_BASE=http://localhost:5000

# Session
SESSION_SECRET=change-me-in-production

# MongoDB
MONGO_URI=mongodb://localhost:27017/attendance

# BLE Payload signing secret (change in production!)
BLE_SECRET=ble-secret-change-in-prod

# Server
PORT=5000
NODE_ENV=development
TZ=Asia/Colombo

# Optional CSP config (production only)
# CSP_EXTRA_CONNECT_SRC=https://api.example.com
# CSP_REPORT_ONLY=1
